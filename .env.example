# Copy this file to .env locally (never commit the real .env).
# On Render, add these under Environment tab -> Environment Variables instead.

# Groq (free) - powers the AI support chat, booking parser, and agent explanations
GROQ_API_KEY=

# OpenRouteService (free, no card) - powers accurate road distance/routing
# Sign up at https://openrouteservice.org -> Dashboard -> generate a token
# If left blank, the app automatically falls back to the free public OSRM server
ORS_API_KEY=
